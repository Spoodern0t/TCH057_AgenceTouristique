<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E72C3834"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".vue.activites.HistoriqueReservationsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="32dp"
        android:text="@string/historique_des_reservations"
        android:textColor="#26A69A"
        android:textSize="32sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listView_reservations_historique"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <LinearLayout
            android:id="@+id/button_accueil_accueil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="45dp"
                android:contentDescription="@string/accueil"
                android:src="@drawable/home" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_historique_accueil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="45dp"
                android:contentDescription="@string/historique"
                android:src="@drawable/reservation" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_logout_accueil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="45dp"
                android:contentDescription="@string/log_out"
                android:src="@drawable/quit" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>