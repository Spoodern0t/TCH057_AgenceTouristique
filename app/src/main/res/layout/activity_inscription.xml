<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAFAF1"
    android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_inscription_titre"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:text="@string/creer_compte"
            android:textColor="@color/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/firstName_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:hint="@string/prenom"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#80000000"
                app:hintTextColor="#80000000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextFirstNameInscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/black_text"
                    android:textColorHint="#78909C"
                    tools:ignore="TouchTargetSizeCheck" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lastName_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="@string/nom"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#80000000"
                app:hintTextColor="#80000000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextLastNameInscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/black_text"
                    android:textColorHint="#78909C"
                    tools:ignore="TouchTargetSizeCheck" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/age_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/age"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextAgeInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/phone_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/telephone"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPhoneInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/address_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/adresse"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextAddressInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/city_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/ville"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCityInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/province_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/province"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextProvinceInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_signup_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/courriel"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextEmailRegisterInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_signup_input_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/mot_de_passe"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#80000000"
            app:hintTextColor="#80000000"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPasswordRegisterInscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/black_text"
                android:textColorHint="#78909C" />
        </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/buttonSignUpInscription"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="@string/creer_compte"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="24dp" />

    <Button
        android:id="@+id/buttonReturnLoginInscription"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/retour_connexion"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>